{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.3.1"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "2.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "state-timeline",
      "name": "State timeline",
      "version": ""
    }
  ],
  "title": "Backup Monitoring",
  "description": "Database backup health dashboard — age, size, verification status, retention, and growth trends. Metrics exported by the node_exporter textfile collector (backup_metrics.sh).",
  "tags": ["sms", "backup", "database", "production"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"
    ]
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Backup Freshness",
      "description": "Normalised freshness score (1.0 = fresh backup < 1 hour, 0.0 = no backup or very old)",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "horizontal",
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "minVizHeight": 75,
        "minVizWidth": 75
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.3 },
              { "color": "yellow", "value": 0.6 },
              { "color": "green", "value": 0.85 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "job:sms_backup_freshness:ratio",
          "legendFormat": "{{ instance }}",
          "interval": "",
          "exemplar": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Backup Age",
      "description": "Age of the latest backup file in hours",
      "type": "stat",
      "gridPos": { "h": 7, "w": 4, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3600 },
              { "color": "red", "value": 129600 }
            ]
          },
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "value": "9999",
              "options": { "9999": { "text": "No backup", "color": "red" } }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sms_backup_age_hours * 3600",
          "legendFormat": "{{ instance }}",
          "interval": "",
          "exemplar": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Verification Status",
      "description": "1 = last verification passed and fresh (< 2h), 0 = not verified or stale",
      "type": "stat",
      "gridPos": { "h": 7, "w": 4, "x": 10, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.5 }
            ]
          },
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "value": "1",
              "options": { "1": { "text": "Verified", "color": "green" } }
            },
            {
              "type": "value",
              "value": "0",
              "options": { "0": { "text": "Stale / Failed", "color": "red" } }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sms_backup_verify_status",
          "legendFormat": "{{ instance }}",
          "interval": "",
          "exemplar": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Backup Count",
      "description": "Total backup files in the backup directory",
      "type": "stat",
      "gridPos": { "h": 7, "w": 4, "x": 14, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sms_backup_count",
          "legendFormat": "{{ instance }}",
          "interval": "",
          "exemplar": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Oldest Backup",
      "description": "Age of the oldest backup file in days — indicates retention coverage",
      "type": "stat",
      "gridPos": { "h": 7, "w": 4, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 7 },
              { "color": "yellow", "value": 30 },
              { "color": "green", "value": 60 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sms_backup_oldest_days",
          "legendFormat": "{{ instance }}",
          "interval": "",
          "exemplar": false,
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Backup Age — 7 Day History",
      "description": "Backup file age over time. Sustained high values indicate backup job failures.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["max", "min", "lastNotNull"],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3600 },
              { "color": "red", "value": 129600 }
            ]
          },
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "stepBefore",
            "lineWidth": 2,
            "pointSize": 2,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sms_backup_age_hours * 3600",
          "legendFormat": "{{ instance }} backup age",
          "interval": "5m",
          "exemplar": true,
          "refId": "A"
        },
        {
          "expr": "36 * 3600",
          "legendFormat": "P1 threshold (36h)",
          "interval": "",
          "exemplar": false,
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "Backup Size — 30 Day History",
      "description": "Latest backup file size over time. Useful for detecting corruption (sudden drops) or unexpected growth.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["max", "min", "lastNotNull", "mean"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1000000 }
            ]
          },
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 30,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "stepBefore",
            "lineWidth": 2,
            "pointSize": 2,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "P2 threshold (1MB)"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.lineInterpolation",
                "value": "linear"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sms_backup_size_bytes",
          "legendFormat": "{{ instance }} backup size",
          "interval": "5m",
          "exemplar": true,
          "refId": "A"
        },
        {
          "expr": "1000000",
          "legendFormat": "P2 threshold (1MB)",
          "interval": "",
          "exemplar": false,
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Backup Verification Timeline",
      "description": "Green = verification passing, Red = verification stale/failing",
      "type": "state-timeline",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.5 }
            ]
          },
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "type": "value",
              "value": "1",
              "options": { "1": { "text": "Verified", "color": "green" } }
            },
            {
              "type": "value",
              "value": "0",
              "options": { "0": { "text": "Stale / Failed", "color": "red" } }
            }
          ],
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineWidth": 0,
            "fillOpacity": 100
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sms_backup_verify_status",
          "legendFormat": "{{ instance }}",
          "interval": "5m",
          "exemplar": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Backup Growth Rate",
      "description": "7-day rate of change in backup file size. Sustained positive slope indicates database growth.",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["max", "mean", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 25000000 },
              { "color": "red", "value": 50000000 }
            ]
          },
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": true,
            "axisColorMode": "text",
            "axisLabel": "bytes/day",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 80,
            "gradientMode": "scheme",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 2,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "job:sms_backup_growth_bytes_per_day:rate",
          "legendFormat": "{{ instance }} daily growth",
          "interval": "1d",
          "exemplar": true,
          "refId": "A"
        },
        {
          "expr": "50000000",
          "legendFormat": "P3 threshold (50 MB/day)",
          "interval": "",
          "exemplar": false,
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "title": "Backup Retention — Oldest Backup Age",
      "description": "Age of the oldest retained backup. Should be >= 90 days for compliance.",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["max", "min", "lastNotNull"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 7 },
              { "color": "yellow", "value": 30 },
              { "color": "green", "value": 60 }
            ]
          },
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "days",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 30,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "stepBefore",
            "lineWidth": 2,
            "pointSize": 2,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Target 90d"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.lineInterpolation",
                "value": "dashed"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sms_backup_oldest_days",
          "legendFormat": "{{ instance }} oldest backup",
          "interval": "5m",
          "exemplar": true,
          "refId": "A"
        },
        {
          "expr": "90",
          "legendFormat": "Target 90d",
          "interval": "",
          "exemplar": false,
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "title": "Backup File Count — 30 Day History",
      "description": "Total backup files in the directory. Should remain stable if retention pruning is working correctly.",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["max", "min", "lastNotNull", "mean"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 40,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 3,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sms_backup_count",
          "legendFormat": "{{ instance }} backup count",
          "interval": "5m",
          "exemplar": true,
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1,
  "links": [],
  "templating": {
    "list": [
      {
        "description": "Prometheus data source",
        "type": "datasource",
        "name": "DS_PROMETHEUS",
        "label": "Data Source",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "skipUrlSync": false
      },
      {
        "description": "Filter by backup host instance",
        "type": "query",
        "name": "instance",
        "label": "Backup Host",
        "query": "label_values(sms_backup_age_hours, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allFormat": "regex wildcard",
        "current": {},
        "options": [],
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "description": "Shows BackupMissing alert firings as annotations on all panels",
        "type": "alert",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "enable": true,
        "iconColor": "red",
        "name": "BackupMissing Alert",
        "query": "ALERTS{alertname=\"BackupMissing\", alertstate=\"firing\"}",
        "showIn": 0,
        "step": "1m",
