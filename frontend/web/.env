# ─── CRA + Docker Compatibility ──────────────────────────────────────────────

# Fix WebSocket HMR port in Docker — CRA's dev server advertises HMR on
# the internal container port, but the browser connects on the mapped port.
# Setting this explicitly prevents "WebSocket connection failed" for hot reload.
WDS_SOCKET_PORT=3000

# Force file polling (required for Docker + Windows + volume mounts where
# inotify events don't propagate). Without this, CRA misses file changes
# and stale chunks persist, causing "Loading chunk X failed" errors.
WATCHPACK_POLLING=true

# Disable source maps in development for faster rebuilds during Docker builds.
# Source maps are still generated for the `react-scripts build` production build.
GENERATE_SOURCEMAP=false

# Disable Fast Refresh in Docker — Fast Refresh has known issues with chunk
# updates in volume-mounted environments. Falls back to full page refresh
# which is more reliable for Docker development.
FAST_REFRESH=false
