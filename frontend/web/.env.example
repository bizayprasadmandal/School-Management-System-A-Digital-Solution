[TEMPLATE]
# EduSphere Web — Environment Configuration
# Source code uses REACT_APP_* (CRA-compatible). Vite maps these to
# import.meta.env.VITE_* at build time via vite.config.ts define blocks.
# Jest uses the REACT_APP_* values directly.
REACT_APP_API_URL=http://localhost:8000/api/v1
REACT_APP_WS_URL=ws://localhost:8000

# Sentry error tracking (optional — leave unset to disable Sentry entirely)
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_RELEASE=
