# ─── Core ─────────────────────────────────────────────────────────────────────
SECRET_KEY=your-50-char-secret-key-here-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sms:sms_password@localhost:5432/sms_db

# Optional read replica (for scaled deployments)
# DATABASE_REPLICA_URL=postgresql://sms_ro:password@replica-host:5432/sms_db

# ─── Database backup (daily Celery beat task) ─────────────────────────────────
# The backup task falls back to the DATABASE_URL settings when these are unset,
# so they only need to be provided when the task must reach a different server.
PGHOST=postgres
PGPORT=5432
PGUSER=sms
PGPASSWORD=sms_password
PGDATABASE=sms_db
SMS_BACKUP_DIR=/backups
SMS_BACKUP_RETENTION_DAYS=30
# Offsite copy (optional; the local backup is always kept even if S3 fails):
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_PREFIX=sms-backups
BACKUP_S3_REGION=us-east-1

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── AWS / S3-Compatible Storage ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=sms-documents
AWS_S3_REGION_NAME=us-east-1
# For MinIO (local dev):
# AWS_S3_ENDPOINT_URL=http://localhost:9000

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@yourschool.edu

# ─── SMS (Twilio) ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ─── Push Notifications (Firebase) ───────────────────────────────────────────
FIREBASE_CREDENTIALS_JSON=/path/to/firebase-credentials.json

# ─── Payment Gateway ──────────────────────────────────────────────────────────
# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Khalti (Nepal) — https://docs.khalti.com/khalti-epayment/
KHALTI_SECRET_KEY=your-khalti-secret-key
KHALTI_MERCHANT_ID=your-khalti-merchant-id

# eSewa (Nepal) — https://developer.esewa.com.np/pages/Epay
ESEWA_MERCHANT_CODE=your-esewa-merchant-code
ESEWA_SECRET_KEY=your-esewa-secret-key

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ─── Integrations ─────────────────────────────────────────────────────────────
# Zoom (Server-to-Server OAuth) — https://developers.zoom.us/docs/internal-apps/s2s-oauth/
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
