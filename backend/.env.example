# ─── Core ─────────────────────────────────────────────────────────────────────
SECRET_KEY=your-50-char-secret-key-here-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sms:sms_password@localhost:5432/sms_db

# Optional read replica (for scaled deployments)
# DATABASE_REPLICA_URL=postgresql://sms_ro:password@replica-host:5432/sms_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── AWS / S3-Compatible Storage ──────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=sms-documents
AWS_S3_REGION_NAME=us-east-1
# For MinIO (local dev):
# AWS_S3_ENDPOINT_URL=http://localhost:9000

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=SG.your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@yourschool.edu

# ─── SMS (Twilio) ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ─── Push Notifications (Firebase) ───────────────────────────────────────────
FIREBASE_CREDENTIALS_JSON=/path/to/firebase-credentials.json

# ─── Payment Gateway ──────────────────────────────────────────────────────────
# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Razorpay (alternative)
# RAZORPAY_KEY_ID=rzp_test_xxxxx
# RAZORPAY_KEY_SECRET=your-secret

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ─── Integrations ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

MICROSOFT_CLIENT_ID=your-ms-app-client-id
MICROSOFT_CLIENT_SECRET=your-ms-app-client-secret

ZOOM_API_KEY=your-zoom-api-key
ZOOM_API_SECRET=your-zoom-api-secret
