# ═══════════════════════════════════════════════════════════════════════════════
# EduSphere SMS — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# Usage:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Fill in your values
#   3. Never commit .env to version control!
#
# 🔴 REQUIRED — These must be set for the app to work
# 🟡 RECOMMENDED — Strongly advised for production
# 🟢 OPTIONAL — Only needed for specific features
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# 🔴 DJANGO — Core Application Settings
# ═══════════════════════════════════════════════════════════════════════════════

# Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Set to True for development, False for production
DEBUG=True

# Comma-separated list of allowed hostnames
# Production: .yourdomain.com,api.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Frontend URL (used in email verification links, CORS, etc.)
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ═══════════════════════════════════════════════════════════════════════════════
# 🔴 DATABASE — PostgreSQL Connection
# ═══════════════════════════════════════════════════════════════════════════════

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://sms:sms@localhost:5432/sms_db

# ═══════════════════════════════════════════════════════════════════════════════
# 🔴 REDIS — Caching, Queues, WebSockets
# ═══════════════════════════════════════════════════════════════════════════════

# Format: redis://HOST:PORT/DB
REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════════════════════════════════════════
# 🟡 EMAIL — Transactional Email Delivery
# ═══════════════════════════════════════════════════════════════════════════════

# Backend: Use 'console' for development (prints to terminal)
#          Use 'smtp' for production (uses the SMTP config below)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Gmail SMTP (replace with your SMTP provider's settings)
# Uncomment and fill in these values for real email delivery:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=${GMAIL_USER}
# EMAIL_HOST_PASSWORD=${GMAIL_APP_PASSWORD}
# DEFAULT_FROM_EMAIL=${GMAIL_USER}

# SendGrid (alternative)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.xxxxx

# ═══════════════════════════════════════════════════════════════════════════════
# 🟡 SENTRY — Error Monitoring
# ═══════════════════════════════════════════════════════════════════════════════

# Get your DSN from https://sentry.io
SENTRY_DSN=

# ═══════════════════════════════════════════════════════════════════════════════
# 🟢 SMS — Attendance Alerts (Twilio / Vonage)
# ═══════════════════════════════════════════════════════════════════════════════

# Provider: "twilio" (default) | "vonage" | "console"
SMS_PROVIDER=console

# Twilio credentials (get from https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Vonage (Nexmo) credentials (alternative to Twilio)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM_NUMBER=

# ═══════════════════════════════════════════════════════════════════════════════
# 🟢 PUSH NOTIFICATIONS — Expo + Firebase FCM
# ═══════════════════════════════════════════════════════════════════════════════

# Expo Access Token (optional — for secure Expo push delivery)
# Get one: https://expo.dev/accounts/{username}/settings/access-tokens
EXPO_ACCESS_TOKEN=

# Firebase credentials JSON path (fallback for non-Expo tokens)
FIREBASE_CREDENTIALS=

# ═══════════════════════════════════════════════════════════════════════════════
# 🟢 STORAGE — File Uploads (S3-compatible)
# ═══════════════════════════════════════════════════════════════════════════════

# Leave empty to use local filesystem storage (media/ directory)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=sms-documents
AWS_S3_ENDPOINT_URL=

# For MinIO (local dev S3): http://localhost:9000
# For AWS S3: https://s3.amazonaws.com

# ═══════════════════════════════════════════════════════════════════════════════
# 🟢 DATABASE BACKUPS — Celery task (services/infrastructure)
# ═══════════════════════════════════════════════════════════════════════════════

# Where the daily backup is written (must match the volume mounted at /backups)
# and the directory the monitoring scripts read from.
SMS_BACKUP_DIR=/backups
# Keep this many days of local backups (pruned daily by the backup task).
SMS_BACKUP_RETENTION_DAYS=30
# Optional offsite copy: leave BACKUP_S3_BUCKET empty to disable.
# Requires the aws CLI to be present in the backend container image.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=
BACKUP_S3_REGION=

# ═══════════════════════════════════════════════════════════════════════════════
# 🟢 VIDEO CONFERENCING — Zoom Integration
# ═══════════════════════════════════════════════════════════════════════════════

# Get these from https://marketplace.zoom.us (Server-to-Server OAuth app)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════════════════════════
# 🟢 PAYMENT GATEWAYS
# ═══════════════════════════════════════════════════════════════════════════════

# Stripe (international credit/debit cards)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Khalti (Nepal)
KHALTI_SECRET_KEY=
KHALTI_MERCHANT_ID=

# eSewa (Nepal)
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=

# Gateway API base URLs — defaults are the sandbox endpoints; set the live
# hosts in production (production.py already falls back to them when DEBUG=False):
#   KHALTI_BASE_URL=https://khalti.com
#   ESEWA_BASE_URL=https://epay.esewa.com.np
#   ESEWA_STATUS_BASE_URL=https://esewa.com.np
KHALTI_BASE_URL=https://dev.khalti.com
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
ESEWA_STATUS_BASE_URL=https://rc.esewa.com.np

# ═══════════════════════════════════════════════════════════════════════════════
# 🟢 TIMEZONE
# ═══════════════════════════════════════════════════════════════════════════════

TIME_ZONE=Asia/Kathmandu
