backend/scripts/*_choices.json
backend/scripts/*_fields.json
backend/scripts/*_map.json
backend/scripts/*_routes.json
backend/scripts/routes_dump.txt
backend/scripts/ui_configs_*.txt
backend/scripts/cluster_*.json
backend/scripts/gb_*.json
backend/scripts/th_*.json
backend/scripts/transport_routes.json
backend/scripts/route_serializer_map.json──────

# ── Playwright ────────────────────────────────────────────────────────────
test-results/
playwright-report/

# ── Node / React ────────────────────────────────────────────────────────
node_modules/
build/
dist/
.cache/
coverage/
*.tsbuildinfo

# ── Expo / React Native ─────────────────────────────────────────────────
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# ── Environment & secrets ───────────────────────────────────────────────
# Never commit real env values — only *.env.example templates are tracked.
.env
.env.*
!.env.example
!**/.env.example
*.pem
google-services.json
GoogleService-Info.plist
*-service-account.json
*-credentials.json

# ── IDE ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# ── Terraform ────────────────────────────────────────────────────────────
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
logs/
backend_logs.txt

# ── Windows ─────────────────────────────────────────────────────────────
# Ignore the Windows reserved device-name file that can appear in repos
nul

# ── Docker ───────────────────────────────────────────────────────────────
docker-compose.override.yml
