		SalaryStructure -> EmployeeSalary [label="1:N" arrowhead=crow]
		EmployeeSalary -> Payslip [label="1:N" arrowhead=crow]
		Employee -> LeaveRequest [label="1:N" arrowhead=crow]
	}
	subgraph cluster_transport {
		color="#e63946" fillcolor="#e63946:20" fontcolor=white label=Transportation style=filled
		Vehicle [label="{Vehicle|{registration_number|type|capacity|make|model|year|l<school>}}" fillcolor="#e63946" fontcolor=white]
		Driver [label="{Driver|{license_number|phone|emergency_contact|l<user> l<school>}}" fillcolor="#f4a261" fontcolor=white]
		Route [label="{Route|{name|start_point|end_point|distance|fare_amount|l<school>}}" fillcolor="#e63946" fontcolor=white]
