	subgraph cluster_admissions {
		color="#1d3557" fillcolor="#1d3557:20" fontcolor=white label=Admissions style=filled
		EnrollmentIntake [label="{EnrollmentIntake|{name|start_date|end_date|capacity|is_open|l<school> l<grade> l<academic_year>}}" fillcolor="#1d3557" fontcolor=white]
		Application [label="{Application|{applicant_name|applicant_email|status|submitted_at|decision_date|l<intake> l<reviewed_by>}}" fillcolor="#457b9d" fontcolor=white]
		ApplicationDocument [label="{ApplicationDocument|{document_type|file|uploaded_at|l<application>}}" fillcolor="#1d3557" fontcolor=white]
		ApplicationReview [label="{ApplicationReview|{rating|comments|decision|l<application> l<reviewer>}}" fillcolor="#457b9d" fontcolor=white]
		School -> EnrollmentIntake [label="1:N" arrowhead=crow]
		EnrollmentIntake -> Application [label="1:N" arrowhead=crow]
		Application -> ApplicationDocument [label="1:N" arrowhead=crow]
		Application -> ApplicationReview [label="1:N" arrowhead=crow]
	}
	subgraph cluster_alumni {
		color="#457b9d" fillcolor="#457b9d:20" fontcolor=white label=Alumni style=filled
		AlumniProfile [label="{AlumniProfile|{graduation_year|current_occupation|organization|l<user> l<school>}}" fillcolor="#457b9d" fontcolor=white]
		AlumniEvent [label="{AlumniEvent|{name|event_type|location|date|description|l<school>}}" fillcolor="#5c9cc9" fontcolor=white]
		AlumniDonation [label="{AlumniDonation|{amount|donation_type|date|payment_method|l<alumni> l<school>}}" fillcolor="#457b9d" fontcolor=white]
		AlumniChapter [label="{AlumniChapter|{name|city|country|description|l<school>}}" fillcolor="#5c9cc9" fontcolor=white]
		User -> AlumniProfile [label="1:1" arrowhead=odiamond]
		School -> AlumniProfile [label="1:N" arrowhead=crow]
		School -> AlumniEvent [label="1:N" arrowhead=crow]
		School -> AlumniDonation [label="1:N" arrowhead=crow]
		School -> AlumniChapter [label="1:N" arrowhead=crow]
		AlumniProfile -> AlumniDonation [label="1:N" arrowhead=crow]
	}
	subgraph cluster_cafeteria {
		color="#e0afa0" fillcolor="#e0afa0:20" fontcolor=white label=Cafeteria style=filled
		MealMenu [label="{MealMenu|{day_of_week|meal_type|main_item|side_item|price|l<school>}}" fillcolor="#d68c79" fontcolor=white]
		MealPlan [label="{MealPlan|{name|description|price_per_period|is_active|l<school>}}" fillcolor="#e0afa0" fontcolor=white]
		MealBooking [label="{MealBooking|{booking_date|meal_type|status|l<student> l<plan>}}" fillcolor="#d68c79" fontcolor=white]
		DietaryRestriction [label="{DietaryRestriction|{restriction_type|allergen|notes|l<student>}}" fillcolor="#e0afa0" fontcolor=white]
		School -> MealMenu [label="1:N" arrowhead=crow]
		School -> MealPlan [label="1:N" arrowhead=crow]
		Student -> MealBooking [label="1:N" arrowhead=crow]
		MealPlan -> MealBooking [label="1:N" arrowhead=crow]
		Student -> DietaryRestriction [label="1:N" arrowhead=crow]
	}
	School -> Grade [label="1:N" arrowhead=crow style=dashed]
	School -> Subject [label="1:N" arrowhead=crow style=dashed]
	School -> AttendanceRecord [label="1:N" arrowhead=crow style=dashed]
	User -> DirectMessage [label="1:N" arrowhead=crow style=dashed]
	User -> Notification [label="1:N" arrowhead=crow style=dashed]
	User -> ConferenceSlot [label="1:N" arrowhead=crow style=dashed]
	User -> Employee [label="1:1" arrowhead=odiamond style=dashed]
	User -> AlumniProfile [label="1:1" arrowhead=odiamond style=dashed]
	Student -> Checkout [label="1:N" arrowhead=crow style=dashed]
	Student -> Incident [label="1:N" arrowhead=crow style=dashed]
	Student -> Referral [label="1:N" arrowhead=crow style=dashed]
	Student -> MealBooking [label="1:N" arrowhead=crow style=dashed]
	Student -> DietaryRestriction [label="1:N" arrowhead=crow style=dashed]
	Student -> ConferenceSlot [label="1:N" arrowhead=crow style=dashed]
	Student -> StudentRoute [label="1:N" arrowhead=crow style=dashed]
	Student -> HostelAllocation [label="1:N" arrowhead=crow style=dashed]
	Student -> SportAchievement [label="1:N" arrowhead=crow style=dashed]
	Student -> TeamMember [label="1:N" arrowhead=crow style=dashed]
}
