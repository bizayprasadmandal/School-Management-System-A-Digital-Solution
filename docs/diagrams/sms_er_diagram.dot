// School Management System - Entity Relationship Diagram
digraph SMS_ER_Diagram {
	bgcolor="#1a1a2e" dpi=150 fontcolor=white fontname=Helvetica fontsize=12 label="School Management System — Entity Relationship Diagram" labeljust=c labelloc=t nodesep=0.5 pad=0.5 rankdir=LR ranksep=1.2 splines=ortho
	node [fontname=Helvetica fontsize=10 shape=record style="filled,rounded"]
	subgraph cluster_auth {
		color="#0f3460" fillcolor="#0f3460:20" fontcolor=white label="Auth & Core" style=filled
		School [label="School|{code|subdomain|name|address|is_active|subscription_tier|l<logo>}" fillcolor="#0f3460" fontcolor=white]
		User [label="{User|{role|email|first_name|last_name|is_active<is_active>|email_verified|two_factor_enabled|l<school>}}" fillcolor="#16213e" fontcolor=white]
		AuditLog [label="{AuditLog|{action|resource_type|resource_id|ip_address|l<school> l<user>}}" fillcolor="#1a1a2e" fontcolor=white]
		UserSession [label="{UserSession|{refresh_token_jti|l<user>|device_info|is_active}}" fillcolor="#1a1a2e" fontcolor=white]
		PasswordResetToken [label="{PasswordResetToken|{token|l<user>|expires_at|used}}" fillcolor="#1a1a2e" fontcolor=white]
		EmailVerificationToken [label="{EmailVerificationToken|{token|l<user>|email|expires_at|used}}" fillcolor="#1a1a2e" fontcolor=white]
		TwoFactorBackupCode [label="{TwoFactorBackupCode|{hashed_code|l<user>|used}}" fillcolor="#1a1a2e" fontcolor=white]
		User -> UserSession [label="1:N" arrowhead=crow]
		User -> PasswordResetToken [label="1:N" arrowhead=crow]
		User -> EmailVerificationToken [label="1:N" arrowhead=crow]
		User -> TwoFactorBackupCode [label="1:N" arrowhead=crow]
		User -> AuditLog [label="1:N" arrowhead=crow]
		School -> User [label="1:N" arrowhead=crow]
		School -> AuditLog [label="1:N" arrowhead=crow]
	}
	subgraph cluster_students {
		color="#16213e" fillcolor="#16213e:20" fontcolor=white label=Students style=filled
		AcademicYear [label="{AcademicYear|{name|start_date|end_date|is_current|l<school>}}" fillcolor="#0d1b2a" fontcolor=white]
		Grade [label="{Grade|{name|level|l<school>}}" fillcolor="#1b263b" fontcolor=white]
		Classroom [label="{Classroom|{name|capacity|room_number|l<school> l<grade> l<academic_year> l<class_teacher>}}" fillcolor="#1b263b" fontcolor=white]
		Student [label="{Student|{admission_number|roll_number|date_of_birth|gender|l<school> l<user>|is_active}}" fillcolor="#0d1b2a" fontcolor=white]
		Guardian [label="{Guardian|{first_name|last_name|email|phone|l<user>|is_primary}}" fillcolor="#1b263b" fontcolor=white]
		StudentGuardian [label="{StudentGuardian|{l<student> l<guardian>|relationship|is_primary_contact|portal_access}}" fillcolor="#0d1b2a" fontcolor=white]
		Enrollment [label="{Enrollment|{l<student> l<classroom> l<academic_year>|status|is_active}}" fillcolor="#1b263b" fontcolor=white]
		Document [label="{Document|{l<student>|document_type|title|l<uploaded_by>}}" fillcolor="#0d1b2a" fontcolor=white]
		School -> AcademicYear [label="1:N" arrowhead=crow]
		School -> Grade [label="1:N" arrowhead=crow]
		School -> Classroom [label="1:N" arrowhead=crow]
		School -> Student [label="1:N" arrowhead=crow]
		Grade -> Classroom [label="1:N" arrowhead=crow]
		AcademicYear -> Classroom [label="1:N" arrowhead=crow]
		AcademicYear -> Enrollment [label="1:N" arrowhead=crow]
		User -> Student [label="1:1" arrowhead=odiamond]
		User -> Guardian [label="1:1" arrowhead=odiamond]
		User -> Classroom [label="1:N" arrowhead=crow headlabel="(class_teacher)"]
		Student -> Enrollment [label="1:N" arrowhead=crow]
		Classroom -> Enrollment [label="1:N" arrowhead=crow]
		Student -> StudentGuardian [label="1:N" arrowhead=crow]
		Guardian -> StudentGuardian [label="1:N" arrowhead=crow]
		Student -> Document [label="1:N" arrowhead=crow]
	}
	subgraph cluster_academics {
		color="#1a1a2e" fillcolor="#1a1a2e:20" fontcolor=white label=Academics style=filled
		Subject [label="{Subject|{name|code|is_core|is_elective|max_marks|l<school> l<grade>}}" fillcolor="#16213e" fontcolor=white]
		TeacherAssignment [label="{TeacherAssignment|{l<teacher> l<subject> l<classroom> l<academic_year>|is_primary}}" fillcolor="#1a1a2e" fontcolor=white]
		TeacherProfile [label="{TeacherProfile|{employee_id|qualification|specialization|department|l<user> l<school>}}" fillcolor="#16213e" fontcolor=white]
		LessonPlan [label="{LessonPlan|{title|topic|date|duration|status|l<assignment>}}" fillcolor="#1a1a2e" fontcolor=white]
		School -> Subject [label="1:N" arrowhead=crow]
		School -> TeacherProfile [label="1:N" arrowhead=crow]
		User -> TeacherProfile [label="1:1" arrowhead=odiamond]
		User -> TeacherAssignment [label="1:N" arrowhead=crow]
		Grade -> Subject [label="1:N" arrowhead=crow]
		Subject -> TeacherAssignment [label="1:N" arrowhead=crow]
		Classroom -> TeacherAssignment [label="1:N" arrowhead=crow]
		AcademicYear -> TeacherAssignment [label="1:N" arrowhead=crow]
		TeacherAssignment -> LessonPlan [label="1:N" arrowhead=crow]
	}
	subgraph cluster_attendance {
		color="#5a189a" fillcolor="#5a189a:20" fontcolor=white label=Attendance style=filled
		AttendanceRecord [label="{AttendanceRecord|{l<student> l<classroom> l<academic_year>|date|status|l<recorded_by>}}" fillcolor="#3c096c" fontcolor=white]
		PeriodAttendance [label="{PeriodAttendance|{l<student> l<assignment>|date|period_number|status|l<recorded_by>}}" fillcolor="#5a189a" fontcolor=white]
		AttendanceLeave [label="{AttendanceLeave|{l<student>|leave_type|from_date|to_date|reason|status|l<reviewed_by>}}" fillcolor="#7b2cbf" fontcolor=white]
		Student -> AttendanceRecord [label="1:N" arrowhead=crow]
		Classroom -> AttendanceRecord [label="1:N" arrowhead=crow]
		AcademicYear -> AttendanceRecord [label="1:N" arrowhead=crow]
		Student -> PeriodAttendance [label="1:N" arrowhead=crow]
		TeacherAssignment -> PeriodAttendance [label="1:N" arrowhead=crow]
		Student -> AttendanceLeave [label="1:N" arrowhead=crow]
	}
	subgraph cluster_gradebook {
		color="#0d7377" fillcolor="#0d7377:20" fontcolor=white label=Gradebook style=filled
		GradingScale [label="{GradingScale|{name|l<school>|is_default}}" fillcolor="#0d7377" fontcolor=white]
		GradingScaleEntry [label="{GradingScaleEntry|{grade_letter|min_percentage|max_percentage|grade_point|l<scale>}}" fillcolor="#14919b" fontcolor=white]
		ExamType [label="{ExamType|{name|weightage|is_terminal|l<school>}}" fillcolor="#0d7377" fontcolor=white]
		Exam [label="{Exam|{name|start_date|end_date|status|l<school> l<academic_year> l<exam_type> l<created_by>}}" fillcolor="#14919b" fontcolor=white]
		ExamSchedule [label="{ExamSchedule|{date|start_time|end_time|venue|max_marks|l<exam> l<subject> l<classroom> l<invigilator>}}" fillcolor="#0d7377" fontcolor=white]
		Grade [label="{Grade|{l<student> l<exam_schedule>|marks_obtained|is_absent|is_pass|l<graded_by>}}" fillcolor="#14919b" fontcolor=white]
		Assessment [label="{Assessment|{title|assessment_type|due_date|max_marks|l<assignment>}}" fillcolor="#0d7377" fontcolor=white]
		AssessmentSubmission [label="{AssessmentSubmission|{l<assessment> l<student>|marks_obtained|submitted_at|file|is_late}}" fillcolor="#14919b" fontcolor=white]
		ReportCard [label="{ReportCard|{l<student> l<exam> l<academic_year>|percentage|gpa|rank_in_class|status}}" fillcolor="#0d7377" fontcolor=white]
		School -> GradingScale [label="1:N" arrowhead=crow]
		School -> ExamType [label="1:N" arrowhead=crow]
		School -> Exam [label="1:N" arrowhead=crow]
		GradingScale -> GradingScaleEntry [label="1:N" arrowhead=crow]
		AcademicYear -> Exam [label="1:N" arrowhead=crow]
		ExamType -> Exam [label="1:N" arrowhead=crow]
		Exam -> ExamSchedule [label="1:N" arrowhead=crow]
		Subject -> ExamSchedule [label="1:N" arrowhead=crow]
		Classroom -> ExamSchedule [label="1:N" arrowhead=crow]
		ExamSchedule -> Grade [label="1:N" arrowhead=crow]
		Student -> Grade [label="1:N" arrowhead=crow]
		TeacherAssignment -> Assessment [label="1:N" arrowhead=crow]
		Assessment -> AssessmentSubmission [label="1:N" arrowhead=crow]
		Student -> AssessmentSubmission [label="1:N" arrowhead=crow]
		Student -> ReportCard [label="1:N" arrowhead=crow]
		Exam -> ReportCard [label="1:N" arrowhead=crow]
	}
	subgraph cluster_fees {
		color="#2d6a4f" fillcolor="#2d6a4f:20" fontcolor=white label=Fees style=filled
		FeeCategory [label="{FeeCategory|{name|is_mandatory|recurrence|l<school>}}" fillcolor="#1b4332" fontcolor=white]
		FeeStructure [label="{FeeStructure|{amount|due_day|late_fee_per_day|l<school> l<academic_year> l<grade> l<fee_category>}}" fillcolor="#2d6a4f" fontcolor=white]
		FeeInvoice [label="{FeeInvoice|{invoice_number|l<student> l<academic_year> l<fee_structure>|due_date|base_amount|total_amount|paid_amount|status|l<created_by>}}" fillcolor="#40916c" fontcolor=white]
		Payment [label="{Payment|{amount|payment_method|status|transaction_id|receipt_number|l<invoice> l<collected_by>}}" fillcolor="#52b788" fontcolor=white]
		Scholarship [label="{Scholarship|{name|discount_type|discount_value|l<school> l<student> l<academic_year>|reason|l<approved_by>}}" fillcolor="#2d6a4f" fontcolor=white]
		PaymentGatewayConfig [label="{PaymentGatewayConfig|{l<school>|stripe_enabled|khalti_enabled|esewa_enabled}}" fillcolor="#40916c" fontcolor=white]
		School -> FeeCategory [label="1:N" arrowhead=crow]
		School -> FeeStructure [label="1:N" arrowhead=crow]
		School -> Scholarship [label="1:N" arrowhead=crow]
		School -> PaymentGatewayConfig [label="1:1" arrowhead=odiamond]
		AcademicYear -> FeeStructure [label="1:N" arrowhead=crow]
		AcademicYear -> FeeInvoice [label="1:N" arrowhead=crow]
		AcademicYear -> Scholarship [label="1:N" arrowhead=crow]
		Grade -> FeeStructure [label="1:N" arrowhead=crow]
		FeeCategory -> FeeStructure [label="1:N" arrowhead=crow]
		FeeCategory -> Scholarship [label="M:N" arrowhead=crow]
		FeeStructure -> FeeInvoice [label="1:N" arrowhead=crow]
		Student -> FeeInvoice [label="1:N" arrowhead=crow]
		Student -> Scholarship [label="1:N" arrowhead=crow]
		FeeInvoice -> Payment [label="1:N" arrowhead=crow]
	}
	subgraph cluster_timetable {
		color="#e07a5f" fillcolor="#e07a5f:20" fontcolor=white label=Timetable style=filled
		Period [label="{Period|{name|period_number|start_time|end_time|is_break|l<school>}}" fillcolor="#e07a5f" fontcolor=white]
		TimetableSlot [label="{TimetableSlot|{day_of_week|l<classroom> l<period> l<subject> l<teacher> l<academic_year>}}" fillcolor="#f4a261" fontcolor=white]
		SchoolEvent [label="{SchoolEvent|{title|description|start_datetime|end_datetime|event_type|l<school>}}" fillcolor="#e07a5f" fontcolor=white]
		School -> Period [label="1:N" arrowhead=crow]
		School -> SchoolEvent [label="1:N" arrowhead=crow]
		Classroom -> TimetableSlot [label="1:N" arrowhead=crow]
		Period -> TimetableSlot [label="1:N" arrowhead=crow]
		Subject -> TimetableSlot [label="1:N" arrowhead=crow]
		User -> TimetableSlot [label="1:N" arrowhead=crow]
	}
	subgraph cluster_communication {
		color="#81b29a" fillcolor="#81b29a:20" fontcolor=white label=Communication style=filled
		Announcement [label="{Announcement|{title|content|priority|audience|is_draft|l<school> l<created_by>}}" fillcolor="#6a994e" fontcolor=white]
		AnnouncementRead [label="{AnnouncementRead|{l<announcement> l<user>|read_at}}" fillcolor="#81b29a" fontcolor=white]
		DirectMessage [label="{DirectMessage|{subject|body|l<sender> l<recipient>|read_at}}" fillcolor="#a7c957" fontcolor=white]
		NotificationTemplate [label="{NotificationTemplate|{event_type|email_subject|email_body|l<school>|is_active}}" fillcolor="#6a994e" fontcolor=white]
		Notification [label="{Notification|{title|body|notification_type|l<user>|is_read}}" fillcolor="#81b29a" fontcolor=white]
		DeviceToken [label="{DeviceToken|{token|device_type|l<user>|is_active}}" fillcolor="#a7c957" fontcolor=white]
		School -> Announcement [label="1:N" arrowhead=crow]
		School -> NotificationTemplate [label="1:N" arrowhead=crow]
		User -> Announcement [label="1:N" arrowhead=crow]
		User -> DirectMessage [label="1:N" arrowhead=crow]
		User -> DirectMessage [label="1:N" arrowhead=crow headlabel="(recipient)"]
		User -> Notification [label="1:N" arrowhead=crow]
		User -> DeviceToken [label="1:N" arrowhead=crow]
		Announcement -> AnnouncementRead [label="1:N" arrowhead=crow]
		User -> AnnouncementRead [label="1:N" arrowhead=crow]
	}
	subgraph cluster_hr {
		color="#3d405b" fillcolor="#3d405b:20" fontcolor=white label="HR & Payroll" style=filled
		Department [label="{Department|{name|code|description|head_of_dept|l<school>}}" fillcolor="#3d405b" fontcolor=white]
		Employee [label="{Employee|{employee_id|designation|department|joining_date|l<user> l<school>}}" fillcolor="#5c5f7e" fontcolor=white]
