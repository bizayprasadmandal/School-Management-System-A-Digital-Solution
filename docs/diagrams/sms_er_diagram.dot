		Payslip [label="{Payslip|{month|year|gross_pay|net_pay|deductions|l<employee_salary>}}" fillcolor="#3d405b" fontcolor=white]
		LeaveRequest [label="{LeaveRequest|{leave_type|from_date|to_date|reason|status|l<employee> l<approved_by>}}" fillcolor="#5c5f7e" fontcolor=white]
